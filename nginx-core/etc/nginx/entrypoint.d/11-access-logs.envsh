ME='11-access-logs.envsh';

if test -n "${NHERIT_ACCESS_LOG:-}"
then
  echo "$ME: NHERIT_ACCESS_LOG already set to '$NHERIT_ACCESS_LOG'";
  return 0;
fi

echo "$ME: Generate access log configuration from NHERIT_ENABLE_ACCESS_LOG";

case "${NHERIT_ENABLE_ACCESS_LOG:-}" in
  1|true|yes|Yes|on|ON|True|TRUE)
    NHERIT_ACCESS_LOG="/var/log/nginx/access.log json";
    ;;
  *)
    NHERIT_ACCESS_LOG="off";
    ;;
esac

echo "$ME: Access log configuration is set to '$NHERIT_ACCESS_LOG'";

export NHERIT_ACCESS_LOG;
